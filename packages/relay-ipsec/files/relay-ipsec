#!/bin/sh
# Fixed-action bridge. JSON credentials use stdin, never command arguments.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
[ "$#" -eq 1 ] || exit 2
case "$1" in
    get|status) action=get ;;
    apply) action=apply ;;
    *) exit 2 ;;
esac
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
mkdir -p /var/lock || fail unavailable
exec 9>/var/lock/relay-ipsec.lock || fail unavailable
# Serialize reads too: clients must never observe a partially applied snapshot.
flock -n 9 || fail busy
[ -x /usr/bin/ucode ] && [ -r /usr/share/relay-ipsec/worker.uc ] || fail unavailable
exec /usr/bin/ucode /usr/share/relay-ipsec/worker.uc "$action" 2>/dev/null
