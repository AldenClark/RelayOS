#!/bin/sh
# Constrained root-only RPC entry point. Do not accept credentials, paths,
# arbitrary command names or interface arguments from the browser.
set -u
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
init=/etc/init.d/swanctl
swan=/usr/sbin/swanctl
guard=/etc/init.d/relay-ipsec-prepare

fail() { echo "$1" >&2; exit 1; }
[ "$#" -eq 1 ] || exit 2
case "$1" in status|enable|disable) action="$1" ;; *) exit 2 ;; esac
[ -x "$init" ] && [ -x "$swan" ] && [ -x "$guard" ] || fail "IPsec components unavailable."

enabled() {
    case "$(uci -q get ipsec.globals.enabled)" in
        1|yes|on|true|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

ready() { timeout 2 "$swan" --stats >/dev/null 2>&1; }

manual_allowed() {
    [ ! -x /etc/init.d/airroute-agent ] && return 0
    local services agent_enabled agent_running
    services="$(ubus -t 3 call rc list '{"name":"airroute-agent"}' 2>/dev/null)" || return 1
    agent_enabled="$(printf '%s' "$services" | jsonfilter -e '@["airroute-agent"].enabled' 2>/dev/null)" || return 1
    agent_running="$(printf '%s' "$services" | jsonfilter -e '@["airroute-agent"].running' 2>/dev/null)" || return 1
    [ "$agent_enabled" = false ] && [ "$agent_running" = false ]
}

status() {
    local en=false active=false loaded=false eip93=false manual=false conns
    enabled && en=true
    if ready; then
        active=true
        conns="$(timeout 2 "$swan" --list-conns 2>/dev/null)" && [ -n "$conns" ] && loaded=true
    fi
    # Registration is evidence of availability only, not an active SA using
    # the accelerator. Never print SA keys or swanctl configuration.
    if grep -Eiq '^driver[[:space:]]*:.*eip93' /proc/crypto 2>/dev/null; then
        eip93=true
    fi
    manual_allowed && manual=true
    printf '{"enabled":%s,"ready":%s,"loaded":%s,"eip93":%s,"manual":%s}\n' \
        "$en" "$active" "$loaded" "$eip93" "$manual"
}

set_enabled() {
    uci -q set "ipsec.globals.enabled=$1" || return 1
    if ! uci -q commit ipsec; then
        uci -q revert ipsec.globals.enabled || :
        return 1
    fi
    chmod 600 /etc/config/ipsec || return 1
}

stop_daemon() {
    "$init" stop >/dev/null 2>&1 || :
    local i
    for i in 1 2 3 4 5; do
        if ! pidof charon >/dev/null 2>&1; then return 0; fi
        sleep 1
    done
    ! pidof charon >/dev/null 2>&1
}

[ "$action" != status ] || { status; exit 0; }
mkdir -p /var/lock || fail "Cannot create IPsec lock directory."
exec 9>/var/lock/relay-ipsec.lock || fail "Cannot open IPsec lock."
flock -n 9 || fail "IPsec configuration is busy."
manual_allowed || fail "IPsec configuration is managed by AirRoute Agent or unavailable."
[ "$(uci -q get ipsec.globals)" = globals ] || fail "IPsec configuration has no globals section."
pending="$(uci -q changes ipsec)" || fail "Cannot read IPsec configuration."
[ -z "$pending" ] || fail "Commit or revert pending IPsec changes first."

if [ "$action" = disable ]; then
    set_enabled 0 || fail "Cannot persist disabled state."
    stop_daemon || fail "IPsec is disabled in configuration but the daemon did not stop."
    status
    exit 0
fi

# No implicit default-route changes or legacy config migration via a web switch.
[ "$(uci -q get ipsec.globals.rtinstall_enabled)" = 0 ] || fail "Automatic IPsec route installation must be disabled."
if uci -q get 'ipsec.@ipsec[0]' >/dev/null 2>&1; then
    fail "Migrate the legacy IPsec configuration before enabling."
fi
"$guard" start >/dev/null 2>&1 || fail "Cannot protect IPsec configuration files."
if enabled && ready; then status; exit 0; fi

# Only the global enable flag is changed; no peer, credential, firewall,
# routing or WireGuard configuration is generated by this helper.
set_enabled 1 || fail "Cannot persist enabled state."
if "$init" enable >/dev/null 2>&1 && "$init" start >/dev/null 2>&1; then
    for i in 1 2 3 4 5; do
        if ready; then status; exit 0; fi
        sleep 1
    done
fi
# A failed start must not leave a boot-enabled daemon or a misleading switch.
set_enabled 0 || fail "IPsec failed to start and disabled state could not be persisted."
stop_daemon || fail "IPsec failed to start and could not be stopped."
fail "IPsec failed to start; service was disabled. Check the system log."
