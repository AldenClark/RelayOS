#!/bin/sh
# rpcd exec plugin. ACLs expose these two typed methods, no arbitrary exec path.
set -eu
case "$1" in
    list)
        [ "$#" -eq 1 ] || exit 2
        printf '%s\n' '{"get":{},"apply":{"config":{}}}'
        ;;
    call)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            get|apply) exec /usr/libexec/relay-ipsec "$2" ;;
            *) exit 2 ;;
        esac
        ;;
    *) exit 2 ;;
esac
