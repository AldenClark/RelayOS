#!/bin/sh /etc/rc.common
# Prepare private runtime configuration before upstream swanctl (START=90).
# No resident process, network changes, or firmware modifications.
START=89

start() {
    umask 077
    mkdir -p /var/ipsec /var/swanctl /etc/swanctl || return 1
    chmod 700 /var/ipsec /var/swanctl /etc/swanctl || return 1
    [ -f /etc/config/ipsec ] || return 1
    chmod 600 /etc/config/ipsec || return 1
}

boot() {
    start || return 1
    # Old or restored configurations must never start IKE just because the
    # upstream init script treats an absent global enable flag as enabled.
    if [ -z "$(uci -q get ipsec.globals.enabled)" ]; then
        uci -q set ipsec.globals=globals || return 1
        uci -q set ipsec.globals.enabled=0 || return 1
        uci -q set ipsec.globals.rtinstall_enabled=0 || return 1
        uci -q commit ipsec || return 1
        chmod 600 /etc/config/ipsec || return 1
    fi
}
