{
  "luci-theme-relay": {
    "description": "Read-only RelayOS node status and console navigation",
    "read": {
      "ubus": {
        "system": [
          "board",
          "info"
        ],
        "network.interface": [
          "dump"
        ],
        "network.device": [
          "status"
        ],
        "file": [
          "read"
        ],
        "rc": [
          "list"
        ]
      },
      "uci": [
        "network",
        "luci"
      ],
      "file": {
        "/tmp/relay-traffic/history": [
          "read"
        ]
      }
    },
    "write": {
      "uci": [
        "luci"
      ]
    }
  },
  "luci-relay-wireguard-restart": {
    "description": "Restart configured WireGuard tunnels",
    "read": {
      "ubus": {
        "network.interface": [
          "dump"
        ]
      }
    },
    "write": {
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/libexec/relay-wg-restart *": [
          "exec"
        ]
      }
    }
  },
  "luci-relay-ipsec": {
    "description": "Read IPsec service status and control only the global enable flag",
    "read": {
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/libexec/relay-ipsec status": [
          "exec"
        ]
      }
    },
    "write": {
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/libexec/relay-ipsec enable": [
          "exec"
        ],
        "/usr/libexec/relay-ipsec disable": [
          "exec"
        ]
      }
    }
  }
}
