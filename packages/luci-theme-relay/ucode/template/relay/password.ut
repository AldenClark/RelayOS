{# SPDX-License-Identifier: Apache-2.0 -#}
{%
    import { open, popen } from 'fs';
    import { cursor } from 'uci';

    function set_unix_password(user, password) {
        if (!match(user, /^[a-zA-Z_][a-zA-Z0-9_.-]*$/))
            return false;
        // LuCI closes stdin after reading the POST. Keep fd 0 occupied so
        // popen() can give its child a separate, usable stdin pipe.
        const stdin_guard = open('/dev/null', 'r');
        if (!stdin_guard)
            return false;
        const process = popen('exec /bin/busybox passwd ' + user + ' >/dev/null 2>&1', 'w');
        stdin_guard.close();
        if (!process)
            return false;

        // BusyBox reads each answer separately and can discard buffered input.
        // Keep the password out of the command line and write it through stdin.
        const line = password + '\n';
        let written = process.write(line) == length(line) && process.flush();
        if (written) {
            system('sleep 1');
            written = process.write(line) == length(line) && process.flush();
        }
        return process.close() == 0 && written;
    }

    function change_password() {
        // The dispatcher requires an authenticated POST and checks the session token.
        const user = ctx.authuser;
        if (!user || dispatched.readonly)
            return 'forbidden';

        const old = http.formvalue('current_password');
        const password = http.formvalue('new_password');
        if (type(old) != 'string' || type(password) != 'string' || !length(password) ||
            length(old) > 1024 || length(password) > 128 ||
            index(password, chr(0)) >= 0 || index(password, '\r') >= 0 || index(password, '\n') >= 0)
            return 'invalid';

        const accounts = [];
        cursor().foreach('rpcd', 'login', account => {
            if (account.username == user)
                push(accounts, account.password);
        });
        if (length(accounts) != 1 || type(accounts[0]) != 'string')
            return 'unavailable';

        const verified = ubus.call('session', 'login', { username: user, password: old, timeout: 30 });
        if (!verified?.ubus_rpc_session)
            return 'incorrect';
        ubus.call('session', 'destroy', { ubus_rpc_session: verified.ubus_rpc_session });

        const unix = match(accounts[0], /^\$p\$(.+)$/);
        if (unix)
            return set_unix_password(unix[1], password) ? 'ok' : 'failed';

        const result = ubus.call('luci', 'setPassword', { username: user, password, oldpassword: old, rpcd: true });
        return result?.result == 1 || result?.result == true ? 'ok' : 'failed';
    }

    http.prepare_content('application/json');
    http.header('Cache-Control', 'no-store');
    http.write_json({ status: change_password() });
-%}
