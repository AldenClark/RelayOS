msgstr "密码已修改，下次登录请使用新密码。"

msgid "The current password is incorrect."
msgstr "当前密码不正确。"

msgid "Enter a valid new password."
msgstr "请输入有效的新密码。"

msgid "Unable to change the password."
msgstr "无法修改密码。"

msgid "Reboot device"
msgstr "重启设备"

msgid "Reboot device…"
msgstr "重启设备…"

msgid "Reboot device?"
msgstr "确定要重启设备吗？"

