msgstr "设备型号"

msgid "No WireGuard interface is configured."
msgstr "尚未配置 WireGuard 接口。"

msgid "Not configured"
msgstr "未配置"

msgid "Not installed"
msgstr "尚未安装"

msgid "Password"
msgstr "密码"

msgid "Recovery mode"
msgstr "恢复模式"

msgid "Secure node management"
msgstr "安全节点管理"

msgid "Selected firmware"
msgstr "所选固件"

msgid "Set an administrator password"
msgstr "请设置管理员密码"

msgid "Set password"
msgstr "设置密码"

msgid "Sign in to manage your edge node."
msgstr "登录后管理您的边缘节点。"

msgid "Static IPv4"
msgstr "静态 IPv4"

msgid "Subnet mask"
msgstr "子网掩码"

msgid "System load"
msgstr "系统负载"

msgid "The firmware cannot be safely installed on this device. Choose the matching MD or MF sysupgrade image."
msgstr "此固件无法安全安装在当前设备。请选择对应 MD 或 MF 型号的 sysupgrade 镜像。"

msgid "The image passed compatibility checks. Confirm the checksum and start the upgrade. Do not disconnect power during flashing."
msgstr "镜像兼容性检查已通过。请核对校验值并确认升级。刷写期间切勿断电。"

msgid "The root account has no password. Set one before connecting to an untrusted network."
msgstr "root 账户尚无密码，请在接入不可信网络前设置。"

msgid "This image cannot preserve existing settings."
msgstr "此镜像无法保留现有设置。"

msgid "Total traffic"
msgstr "累计流量"

msgid "Unavailable"
msgstr "未获取"

msgid "Updated at %s"
msgstr "更新于 %s"

msgid "Upload"
msgstr "上传"

msgid "Uptime"
msgstr "运行时间"

msgid "Username"
msgstr "用户名"

msgid "Validating compatibility with this device."
msgstr "正在校验镜像与设备的兼容性。"

msgid "Welcome back"
msgstr "欢迎回来"

msgid "Without preserved settings, the management IP may change because RelayOS obtains its address via DHCP."
msgstr "如果不保留现有配置，RelayOS 会通过 DHCP 获取管理地址，升级后 IP 可能发生变化。"

msgid "WireGuard"
msgstr "WireGuard"

msgid "WireGuard tunnels"
msgstr "WireGuard 隧道"

msgid "br-lan · management"
msgstr "br-lan · 管理接口"

msgid "Settings"
msgstr "设置"

msgid "Network interfaces"
msgstr "网络接口"

msgid "System management"
msgstr "系统管理"

msgid "Reset system"
msgstr "重置系统"

msgid "Reset system…"
msgstr "重置系统…"

msgid "Reset system?"
msgstr "确认重置系统？"

msgid "All settings will be erased and the device will restart. Its management address will be obtained via DHCP."
msgstr "所有设置将被清除，设备将重新启动，并通过 DHCP 获取管理地址。"

msgid "Resetting system…"
msgstr "正在重置系统…"

msgid "Erasing settings and restarting. Find the new address in your router’s DHCP leases."
msgstr "正在清除设置并重启。请在路由器的 DHCP 租约中查找新地址。"

msgid "System reset failed."
msgstr "系统重置失败。"

msgid "1 hour ago"
msgstr "1 小时前"

msgid "Now"
msgstr "现在"

msgid "Save & Apply"
msgstr "保存并应用"

msgid "Unable to detect AirRoute Agent."
msgstr "无法检测 AirRoute Agent 状态，请刷新页面。"

msgid "AirRoute Agent is managing WireGuard. Refresh this page."
msgstr "AirRoute Agent 已接管 WireGuard，请刷新页面。"

msgid "Enter a valid WireGuard key."
msgstr "请输入有效的 WireGuard 密钥。"

msgid "No firewall zone is assigned to the management interface."
msgstr "管理接口尚未关联防火墙区域。"

msgid "A firewall rule name is already in use."
msgstr "防火墙规则名称已被占用。"

msgid "Keep the management default route outside WireGuard."
msgstr "请勿将设备默认路由切换到 WireGuard。"

msgid "Create tunnel"
msgstr "创建隧道"

msgid "Interface name is already in use."
msgstr "接口名称已被占用。"

msgid "Enable tunnel"
msgstr "启用隧道"

msgid "Private key"
msgstr "私钥"

msgid "Local public key"
msgstr "本机公钥"

msgid "Tunnel IPv4 addresses"
msgstr "隧道 IPv4 地址"

msgid "Listen port"
msgstr "监听端口"

msgid "Automatic"
msgstr "自动"

msgid "Peers"
msgstr "对端"

msgid "Add peer"
msgstr "添加对端"

msgid "Name"
msgstr "名称"

msgid "Peer public key"
msgstr "对端公钥"

msgid "Preshared key"
msgstr "预共享密钥"

msgid "Endpoint host"
msgstr "对端地址"

msgid "Endpoint port"
msgstr "对端端口"

msgid "Allowed IPv4 addresses"
msgstr "允许的 IPv4 地址"

msgid "Create routes for allowed addresses"
msgstr "为允许的地址创建路由"

msgid "Keepalive interval"
msgstr "保活间隔（秒）"

msgid "Configure"
msgstr "配置"

msgid "Keep at least one peer."
msgstr "请至少保留一个对端。"

msgid "Restart tunnel"
msgstr "重启隧道"

msgid "Restarting…"
msgstr "正在重启…"

msgid "Tunnel restart failed."
msgstr "隧道重启失败。"

msgid "IPsec service operation failed."
msgstr "IPsec 服务操作失败。"

msgid "IPsec service status is unavailable."
msgstr "无法获取 IPsec 服务状态。"

msgid "IPsec is managed by AirRoute Agent or unavailable."
msgstr "IPsec 由 AirRoute Agent 管理，或当前无法操作。"

msgid "IPsec service operation failed. Check the system log and SSH configuration."
msgstr "IPsec 服务操作失败，请检查系统日志和 SSH 配置。"

msgid "IKE service ready"
msgstr "IKE 服务已就绪"

msgid "IKE service still responding"
msgstr "IKE 服务仍在响应"

msgid "IKE service not responding"
msgstr "IKE 服务未响应"

msgid "Disabled"
msgstr "已关闭"

msgid "Enable IPsec"
msgstr "开启 IPsec"

msgid "Disable IPsec"
msgstr "关闭 IPsec"

msgid "IPsec (IKEv2)"
msgstr "IPsec（IKEv2）"

msgid "Connection definitions loaded; this does not prove a tunnel is established."
msgstr "连接配置已加载；不代表隧道已建立。"

msgid "No connection definitions loaded."
msgstr "尚未加载连接配置。"

msgid "EIP-93 driver registered; hardware use depends on the negotiated ESP algorithm."
msgstr "EIP-93 驱动已注册，是否使用硬件加速取决于协商的 ESP 算法。"

msgid "EIP-93 driver not registered."
msgstr "EIP-93 驱动尚未注册。"

msgid "Configure peers, credentials and XFRM routes through SSH or AirRoute Agent. Enabling the service does not open firewall ports or change routes."
msgstr "通过 SSH 或 AirRoute Agent 配置对端、凭据和 XFRM 路由。开启服务不会自动开放防火墙端口或修改路由。"

msgid "IPsec settings changed elsewhere. Discard this draft and review the current settings."
msgstr "IPsec 配置已被其他操作修改。请放弃当前草稿，重新查看最新配置。"

msgid "Another IPsec operation is in progress. Try again shortly."
msgstr "另一个 IPsec 操作正在进行，请稍后重试。"

msgid "IPsec settings conflict with an existing route, interface or configuration. Review the settings."
msgstr "IPsec 配置与现有路由、接口或其他配置冲突，请检查设置。"

msgid "IKE identities conflict with another peer. Check local and remote identities."
msgstr "IKE 身份与其他对端冲突，请检查本地和远端身份。"

msgid "A new peer requires a preshared key."
msgstr "新增对端必须填写预共享密钥。"

msgid "Other network or firewall changes are pending. Apply or discard those changes first."
msgstr "网络或防火墙还有未应用的修改，请先应用或放弃这些修改。"

msgid "Existing unmanaged IPsec configuration must be reviewed before using this editor."
msgstr "检测到不由此页面管理的 IPsec 配置，请先检查现有配置再使用此编辑器。"

msgid "IPsec components are unavailable. Check the installed firmware packages."
msgstr "IPsec 组件不可用，请检查固件中的相关软件包。"

msgid "IPsec settings were rejected. Check the peer parameters and address ranges."
msgstr "IPsec 配置未通过校验，请检查对端参数和地址范围。"

msgid "IPsec application and rollback failed. Inspect the device through SSH before making further changes."
msgstr "IPsec 配置应用和回滚均失败，请先通过 SSH 检查设备，再进行其他修改。"

msgid "IPsec settings could not be applied. Review the service status and system log; your draft has been kept."
msgstr "IPsec 配置应用失败，请检查服务状态和系统日志；当前草稿已保留。"

msgid "Peer identifiers must be unique. Reload the editor."
msgstr "对端标识必须唯一，请重新加载编辑器。"

msgid "Give every peer a name of 1 to 64 UTF-8 bytes, without control characters."
msgstr "请为每个对端填写名称，长度为 1～64 个 UTF-8 字节，且不能包含控制字符。"

msgid "Enter a valid peer IPv4 address or DNS hostname, without a port."
msgstr "请输入有效的对端 IPv4 地址或域名，不要附带端口。"

msgid "IKE identities must start with a letter or digit (optionally after @) and contain only letters, digits, dots, @, underscores and hyphens."
msgstr "IKE 身份须以字母或数字开头（前面可加 @），且只能包含字母、数字、点、@、下划线和连字符。"

msgid "Each peer must have a different remote IKE identity."
msgstr "每个对端必须使用不同的远端 IKE 身份。"

msgid "Enter a local tunnel IPv4 address with a /32 prefix."
msgstr "请输入前缀为 /32 的本地隧道 IPv4 地址。"

msgid "Local tunnel IPv4 addresses must be different for each peer."
msgstr "不同对端的本地隧道 IPv4 地址不能相同。"

msgid "Enter from 1 to 32 remote IPv4 subnets."
msgstr "请输入 1～32 个远端 IPv4 网段。"

msgid "Enter valid IPv4 CIDRs; a default route (/0) is not allowed."
msgstr "请输入有效的 IPv4 CIDR；不允许配置默认路由（/0）。"

msgid "Remote subnets must not contain unspecified, loopback, link-local or multicast addresses."
msgstr "远端网段不能包含未指定、环回、链路本地或组播地址。"

msgid "Remote IPv4 subnets must not overlap, including between peers."
msgstr "远端 IPv4 网段不能重叠，不同对端之间也不能重叠。"

msgid "Enter a preshared key of 16 to 128 UTF-8 bytes."
msgstr "请输入长度为 16～128 个 UTF-8 字节的预共享密钥。"

msgid "Enter a preshared key of 16 to 128 UTF-8 bytes without control characters."
msgstr "请输入长度为 16～128 个 UTF-8 字节且不含控制字符的预共享密钥。"

msgid "Select a supported IKE and ESP proposal."
msgstr "请选择受支持的 IKE 和 ESP 算法组合。"

msgid "DPD interval must be an integer from 10 to 3600 seconds."
msgstr "DPD 检测间隔必须为 10～3600 秒的整数。"

msgid "MTU must be an integer from 576 to 1500."
msgstr "MTU 必须为 576～1500 的整数。"

msgid "A local tunnel address must not equal an IKE endpoint address."
msgstr "本地隧道地址不能与 IKE 对端地址相同。"

msgid "A remote subnet must not include a local tunnel address."
msgstr "远端网段不能包含本地隧道地址。"

msgid "A remote subnet must not include an IKE endpoint address."
msgstr "远端网段不能包含 IKE 对端地址。"

msgid "IPsec settings applied. A ready IKE service does not by itself mean every tunnel is connected."
msgstr "IPsec 配置已应用。IKE 服务就绪不代表所有隧道都已连接。"

msgid "Connecting"
msgstr "连接中"

msgid "Not connected"
msgstr "未连接"

msgid "Not yet applied"
msgstr "尚未应用"

msgid "Discard changes"
msgstr "放弃修改"

msgid "Refresh status"
msgstr "刷新状态"

msgid "New peer"
msgstr "新对端"

msgid "Remove peer"
msgstr "删除对端"

msgid "Enable peer"
msgstr "启用对端"

msgid "IPv4 address or DNS hostname of the remote IKE peer."
msgstr "远端 IKE 对端的 IPv4 地址或域名。"

msgid "Local IKE identity"
msgstr "本地 IKE 身份"

msgid "Remote IKE identity"
msgstr "远端 IKE 身份"

msgid "A key is stored. Leave this field blank to keep it; enter a new key to replace it."
msgstr "已保存密钥。留空可保留原密钥，填写新密钥将替换原密钥。"

msgid "Required for a new peer. Use a random key of 16 to 128 UTF-8 bytes."
msgstr "新增对端必填。请使用长度为 16～128 个 UTF-8 字节的随机密钥。"

msgid "Local tunnel IPv4 address"
msgstr "本地隧道 IPv4 地址"

msgid "Use a different /32 address for every peer."
msgstr "请为每个对端使用不同的 /32 地址。"

msgid "Remote IPv4 subnets"
msgstr "远端 IPv4 网段"

msgid "One IPv4 CIDR per line. No default route, overlapping peer routes or WireGuard routes."
msgstr "每行一个 IPv4 CIDR。不允许默认路由，也不能与其他对端或 WireGuard 的路由重叠。"

msgid "Advanced parameters"
msgstr "高级参数"

msgid "IKE proposal"
msgstr "IKE 算法组合"

msgid "ESP proposal"
msgstr "ESP 算法组合"

msgid "DPD interval (seconds)"
msgstr "DPD 检测间隔（秒）"

msgid "Tunnel MTU"
msgstr "隧道 MTU"

msgid "NAT traversal is automatic. AES-CBC/SHA-256 is the EIP-93 test profile; AES-GCM may use CPU crypto."
msgstr "自动处理 NAT 穿越。AES-CBC/SHA-256 用于 EIP-93 性能测试；AES-GCM 可能使用 CPU 加密。"

msgid "Changes are applied only when you save. Disabled peers keep protected routes; removing a peer removes its routes."
msgstr "修改仅在保存时生效。关闭对端会保留受保护的路由；删除对端则会移除其路由。"

msgid "No IPsec peers configured. Add a peer to create a tunnel."
msgstr "尚未配置 IPsec 对端。添加对端即可创建隧道。"

msgid "Applying…"
msgstr "正在应用…"

msgid "Unsaved changes"
msgstr "有未保存的修改"

msgid "IPsec settings are read-only for this session."
msgstr "当前会话仅可查看 IPsec 设置。"

msgid "At most 256 remote IPv4 subnets are allowed across all peers, including disabled peers."
msgstr "所有对端的远端 IPv4 子网合计不得超过 256 个，已关闭的对端也计入总数。"

msgid "Editor resource limits: 64 peers, 32 subnets per peer, 256 subnets total including disabled peers; not protocol or hardware limits."
msgstr "编辑器资源上限：64 个对端、每对端 32 个子网、总计 256 个子网（含已关闭的对端）；这不是协议或硬件限制。"
