msgstr "添加对端"

msgid "Name"
msgstr "名称"

msgid "Peer public key"
msgstr "对端公钥"

msgid "Preshared key"
msgstr "预共享密钥"

msgid "Endpoint host"
msgstr "对端地址"

msgid "Endpoint port"
msgstr "对端端口"

msgid "Allowed IPv4 addresses"
msgstr "允许的 IPv4 地址"

msgid "Create routes for allowed addresses"
msgstr "为允许的地址创建路由"

msgid "Keepalive interval"
msgstr "保活间隔（秒）"

msgid "Configure"
msgstr "配置"

msgid "Keep at least one peer."
msgstr "请至少保留一个对端。"

msgid "Restart tunnel"
msgstr "重启隧道"

msgid "Restarting…"
msgstr "正在重启…"

msgid "Tunnel restart failed."
msgstr "隧道重启失败。"

msgid "Enable peer"
msgstr "启用对端"

msgid "Another network operation is in progress. Try again shortly."
msgstr "另一个网络操作正在进行，请稍后重试。"

msgid "Discard pending network and firewall changes before applying without the WireGuard editor."
msgstr "当前无法编辑 WireGuard。请先放弃待应用的网络和防火墙修改，再应用管理网络设置。"

msgid "Each peer in a WireGuard tunnel must have a different public key."
msgstr "同一 WireGuard 隧道中的每个对端必须使用不同的公钥。"

msgid "Enabled WireGuard tunnels must use different listen ports."
msgstr "已启用的 WireGuard 隧道必须使用不同的监听端口。"

msgid "Enter a tunnel IPv4 address."
msgstr "请输入隧道 IPv4 地址。"

msgid "Enter a valid management IPv4 address and contiguous subnet mask."
msgstr "请输入有效的管理 IPv4 地址，以及连续的子网掩码。"

msgid "Network and WireGuard changes are validated and applied together."
msgstr "管理网络与 WireGuard 的修改会一并校验和应用。"

msgid "Network settings are read-only."
msgstr "当前会话仅可查看网络设置。"

msgid "The management subnet conflicts with a WireGuard tunnel."
msgstr "管理网络与 WireGuard 隧道网段冲突。"

msgid "Tunnel and management firewall zones must be unambiguous."
msgstr "隧道和管理接口的防火墙分区归属必须唯一。"

msgid "Unable to verify current network routes."
msgstr "无法核实当前网络路由。"

msgid "WireGuard addresses or routes conflict with another tunnel or the management network."
msgstr "WireGuard 地址或路由与其他隧道或管理网络冲突。"

msgid "WireGuard settings are read-only."
msgstr "当前会话仅可查看 WireGuard 设置。"

msgid "Network changes may have been partially saved. Reload this page and review pending changes before applying again."
msgstr "部分网络修改可能已保存。请重新加载此页面并检查待应用的修改，然后再尝试应用。"

msgid "Unable to apply network settings."
msgstr "无法应用网络设置。"

msgid "Save error"
msgstr "保存出错"

msgid "Reload page"
msgstr "重新加载页面"

msgid "Enter a valid IPv4 address or prefix."
msgstr "请输入有效的 IPv4 地址或网段。"

msgid "Keep at least one enabled peer."
msgstr "请至少保留一个已启用的对端。"

msgid "The firewall forwarding from the tunnel to the management zone is disabled."
msgstr "隧道分区到管理分区的防火墙转发已停用。"

msgid "The management and tunnel firewall zones must be enabled."
msgstr "管理网络和隧道使用的防火墙分区必须启用。"

msgid "The management and tunnel firewall zones must support IPv4."
msgstr "管理网络和隧道使用的防火墙分区必须支持 IPv4。"

msgid "Unable to update the WireGuard draft."
msgstr "无法更新 WireGuard 草稿。"

msgid "Connection status"
msgstr "连接状态"

msgid "Peer disabled"
msgstr "已禁用"

msgid "Status unavailable"
msgstr "状态不可用"

msgid "Peer not active"
msgstr "对端未运行"

