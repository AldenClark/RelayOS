#!/bin/sh
# Preserved sysupgrade backups may contain sections generated by the old VPN editor.
# Remove only sections owned by RelayOS, including the protected routes and firewall rules.
umask 077
delta="$(mktemp -d)" || exit 1
trap 'rm -rf "$delta"' EXIT

for package in network firewall ipsec; do
	[ -f "/etc/config/$package" ] || continue
	config="$(uci -p "$delta" -X -q show "$package")" || exit 1
	sections="$(printf '%s\n' "$config" | sed -n "s/^\($package\.[[:alnum:]_][[:alnum:]_]*\)\.relay_owner='relay-ipsec-v1'$/\1/p")"
	[ -n "$sections" ] || continue
	for section in $sections; do
		[ "$(uci -p "$delta" -q get "$section.relay_owner")" = 'relay-ipsec-v1' ] || continue
		uci -t "$delta" -p "$delta" -q delete "$section" || exit 1
	done
	uci -p "$delta" -q commit "$package" || exit 1
done

rm -f /etc/config/relay_ipsec || exit 1
exit 0
