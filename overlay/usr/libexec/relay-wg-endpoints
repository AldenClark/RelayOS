#!/bin/sh
. /lib/functions.sh

check_peer() {
	local peer="$1" key host disabled endpoint
	config_get disabled "$peer" disabled
	[ "$disabled" != 1 ] || return 0
	config_get key "$peer" public_key
	config_get host "$peer" endpoint_host

	case "$host" in
		''|[!a-zA-Z0-9]*|*[!a-zA-Z0-9._-]*) return 0 ;;
		*[a-zA-Z]*) ;;
		*) return 0 ;;
	esac
	[ -n "$key" ] || return 0

	endpoint="$(printf '%s\n' "$endpoints" | awk -v key="$key" '$1 == key { print $2; exit }')"
	case "$endpoint" in
		'') pending=1 ;;
		'(none)')
			pending=1
			case " $retried " in *" $interface:$key "*) return 0 ;; esac
			if resolveip -t 2 "$host" >/dev/null 2>&1; then
				ready="$ready $interface:$key"
			fi
			;;
	esac
	return 0
}

check_interface() {
	local interface="$1" proto disabled auto endpoints ready=
	config_get proto "$interface" proto
	[ "$proto" = wireguard ] || return 0
	config_get_bool disabled "$interface" disabled 0
	config_get_bool auto "$interface" auto 1
	[ "$disabled" = 0 ] && [ "$auto" = 1 ] || return 0

	endpoints="$(wg show "$interface" endpoints 2>/dev/null)"
	config_foreach check_peer "wireguard_$interface"
	if [ -n "$ready" ] && /usr/libexec/relay-wg-restart "$interface"; then
		# Reapply through netifd so it installs the normal uplink host routes.
		# A peer can trigger just one successful reapply per boot.
		retried="$retried$ready"
	fi
	return 0
}

retried=
# Bound startup retries, including when the uplink is deliberately unplugged.
for attempt in $(seq 1 25); do
	pending=0
	config_load network || exit 1
	config_foreach check_interface interface
	[ "$pending" = 1 ] && [ "$attempt" -lt 25 ] || exit 0
	sleep 5 || exit 1
done
